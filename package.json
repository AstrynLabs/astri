{
  "name": "astri",
  "version": "2.7.4",
  "description": "A fork of Eris",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=10.4.0"
  },
  "scripts": {
    "build": "tsup lib --format cjs,esm --dts --clean --no-splitting",
    "format": "prettier . --write",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FireGamer3/astri.git"
  },
  "keywords": [
    "api",
    "discord",
    "discordapp",
    "astri",
    "wrapper"
  ],
  "license": "NOLICENSE",
  "dependencies": {
    "discord-api-types": "^0.38.1",
    "eventemitter3": "^5.0.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@eslint/js": "^9.22.0",
    "@types/node": "^20.12.7",
    "@types/ws": "^8.5.11",
    "globals": "^16.0.0",
    "prettier": "^3.2.5",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.26.1"
  },
  "peerDependencies": {
    "zlib-sync": "0.1.9"
  },
  "browser": {
    "@discordjs/opus": false,
    "child_process": false,
    "dgram": false,
    "dns": false,
    "fs": false,
    "tls": false,
    "tweetnacl": false,
    "ws": false
  }
}
